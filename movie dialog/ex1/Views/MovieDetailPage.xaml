<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MovieCatalog.ViewModels"
             x:Class="MovieCatalog.Views.MovieDetailPage"
             x:DataType="vm:MovieViewModel"
             Title="Movie"
             BackgroundColor="#140F24">

    <ScrollView>
        <Grid Padding="18" RowDefinitions="Auto,Auto" RowSpacing="16">
            <Border StrokeThickness="0" BackgroundColor="#EC4899" StrokeShape="RoundRectangle 24" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Feature Spotlight" TextColor="#FCE7F3" FontSize="13" />
                    <Label Text="{Binding Title}" TextColor="White" FontSize="30" FontAttributes="Bold" />
                    <Label Text="Release: {Binding Year, StringFormat='{0:yyyy}'}" TextColor="#FBCFE8" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1" BackgroundColor="#2A1C45" Stroke="#A78BFA" StrokeShape="RoundRectangle 22" Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="14" ColumnSpacing="16">
                    <Label Text="Studio" TextColor="#F5D0FE" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding Studio}" TextColor="#FAF5FF" />

                    <Label Grid.Row="1" Text="Director" TextColor="#F5D0FE" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Director}" TextColor="#FAF5FF" />

                    <Label Grid.Row="2" Text="Year" TextColor="#F5D0FE" FontAttributes="Bold" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Year, StringFormat='{0:yyyy}'}" TextColor="#FAF5FF" />
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
