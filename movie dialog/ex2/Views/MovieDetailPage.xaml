<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MovieCatalog.ViewModels"
             x:Class="MovieCatalog.Views.MovieDetailPage"
             x:DataType="vm:MovieViewModel"
             Title="Movie"
             BackgroundColor="#020617">

    <ScrollView>
        <Grid Padding="18" RowDefinitions="Auto,Auto" RowSpacing="16">
            <Border StrokeThickness="0" BackgroundColor="#0EA5E9" StrokeShape="RoundRectangle 24" Padding="20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Selected Film" TextColor="#083344" FontSize="13" />
                    <Label Text="{Binding Title}" TextColor="#082F49" FontSize="30" FontAttributes="Bold" />
                    <Label Text="Year: {Binding Year, StringFormat='{0:yyyy}'}" TextColor="#0C4A6E" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1" BackgroundColor="#0F172A" Stroke="#334155" StrokeShape="RoundRectangle 22" Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="14" ColumnSpacing="16">
                    <Label Text="Studio" TextColor="#67E8F9" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding Studio}" TextColor="White" />

                    <Label Grid.Row="1" Text="Director" TextColor="#67E8F9" FontAttributes="Bold" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Director}" TextColor="White" />

                    <Label Grid.Row="2" Text="Release" TextColor="#67E8F9" FontAttributes="Bold" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Year, StringFormat='{0:yyyy}'}" TextColor="White" />
                </Grid>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
