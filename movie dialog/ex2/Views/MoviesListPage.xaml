<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MovieCatalog.ViewModels"
             xmlns:local="clr-namespace:MovieCatalog"
             x:Class="MovieCatalog.Views.MoviesListPage"
             x:DataType="vm:MovieListViewModel"
             Title="Movies"
             BackgroundColor="#052E2B"
             BindingContext="{x:Static local:App.MainViewModel}">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">
        <Border StrokeThickness="0" BackgroundColor="#34D399" StrokeShape="RoundRectangle 24" Padding="18">
            <VerticalStackLayout Spacing="6">
                <Label Text="Greenlight Catalog" TextColor="#022C22" FontSize="30" FontAttributes="Bold" />
                <Label Text="Tap a film for details. Swipe left to delete via command binding."
                       TextColor="#064E3B"
                       FontSize="14" />
            </VerticalStackLayout>
        </Border>

        <ListView Grid.Row="1"
                  BackgroundColor="#052E2B"
                  HasUnevenRows="True"
                  SeparatorVisibility="None"
                  ItemsSource="{Binding Movies}"
                  SelectedItem="{Binding SelectedMovie, Mode=OneWayToSource}"
                  ItemTapped="ListView_ItemTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MovieViewModel">
                    <ViewCell>
                        <Border Margin="0,0,0,12" Padding="14" BackgroundColor="#064E3B" Stroke="#6EE7B7" StrokeShape="RoundRectangle 16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="🎞️" FontSize="28" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Title}" TextColor="#ECFDF5" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="View cast and production info" TextColor="#A7F3D0" FontSize="13" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <ViewCell.ContextActions>
                            <MenuItem Text="Delete"
                                      IsDestructive="True"
                                      Command="{Binding DeleteMovieCommand, Source={x:Static local:App.MainViewModel}}"
                                      CommandParameter="{Binding}" />
                        </ViewCell.ContextActions>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentPage>
