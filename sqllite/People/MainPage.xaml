<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="People.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#070B14">

    <Grid RowDefinitions="Auto,*" Padding="20,26,20,18" RowSpacing="16">

        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <Label
                Text="SQLite People Studio"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#F8FAFC" />

            <Label
                Grid.Row="1"
                Text="A redesigned workspace for managing local names"
                FontSize="14"
                TextColor="#94A3B8" />

            <Border
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,8"
                HorizontalOptions="Start"
                BackgroundColor="#1E293B"
                Stroke="#334155"
                StrokeShape="RoundRectangle 999">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="💾" FontSize="14" />
                    <Label
                        Text="SQLite Connected"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#C7D2FE" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="14">

            <Border
                Padding="18"
                BackgroundColor="#0F172A"
                Stroke="#1E293B"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24">

                <VerticalStackLayout Spacing="14">
                    <Label
                        Text="Add a Person"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#E2E8F0" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border
                            Stroke="#334155"
                            StrokeThickness="1"
                            BackgroundColor="#020617"
                            Padding="12,2"
                            StrokeShape="RoundRectangle 16">
                            <Entry
                                x:Name="newPerson"
                                Placeholder="Type full name"
                                PlaceholderColor="#64748B"
                                FontSize="16"
                                TextColor="#E2E8F0"
                                ClearButtonVisibility="WhileEditing" />
                        </Border>

                        <Button
                            Grid.Column="1"
                            Text="Add"
                            Clicked="OnNewButtonClicked"
                            WidthRequest="88"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#2563EB"
                            CornerRadius="14" />
                    </Grid>

                    <Label
                        x:Name="statusMessage"
                        TextColor="#86EFAC"
                        FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border
                Grid.Row="1"
                Padding="14"
                BackgroundColor="#111827"
                Stroke="#1F2937"
                StrokeShape="RoundRectangle 20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label
                            Text="Saved Records"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#F8FAFC" />
                        <Label
                            Text="Tap refresh to load everyone from SQLite"
                            FontSize="12"
                            TextColor="#9CA3AF" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="Refresh"
                        Clicked="OnGetButtonClicked"
                        HeightRequest="42"
                        Padding="18,0"
                        BackgroundColor="#0EA5E9"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14" />
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Padding="12"
                BackgroundColor="#0B1220"
                Stroke="#1E293B"
                StrokeShape="RoundRectangle 24">
                <CollectionView
                    x:Name="peopleList"
                    SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="26" Spacing="8">
                            <Label
                                Text="No entries yet"
                                HorizontalTextAlignment="Center"
                                TextColor="#CBD5E1"
                                FontSize="16"
                                FontAttributes="Bold" />
                            <Label
                                Text="Create your first person above, then refresh this list."
                                HorizontalTextAlignment="Center"
                                TextColor="#64748B"
                                FontSize="13" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6,6,6,8">
                                <Border
                                    Padding="14"
                                    BackgroundColor="#111827"
                                    Stroke="#374151"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            BackgroundColor="#1D4ED8"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                            <Label
                                                Text="👤"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                FontSize="20" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding Name}"
                                                TextColor="#F8FAFC"
                                                FontSize="17"
                                                FontAttributes="Bold" />
                                            <Label
                                                Text="{Binding Id, StringFormat='SQLite row #{0}'}"
                                                TextColor="#94A3B8"
                                                FontSize="12" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="2"
                                            Text="LOCAL"
                                            VerticalOptions="Center"
                                            FontSize="10"
                                            TextColor="#93C5FD"
                                            FontAttributes="Bold" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
