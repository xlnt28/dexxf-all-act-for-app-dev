<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="People.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#ECFEFF">

    <Grid RowDefinitions="Auto,*" Padding="20,26,20,18" RowSpacing="16">

        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <Label
                Text="People Ledger"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="#164E63" />

            <Label
                Grid.Row="1"
                Text="Warm daylight theme for your SQLite records"
                FontSize="14"
                TextColor="#0E7490" />

            <Border
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,8"
                HorizontalOptions="Start"
                BackgroundColor="#CFFAFE"
                Stroke="#67E8F9"
                StrokeShape="RoundRectangle 999">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="📀" FontSize="14" />
                    <Label
                        Text="Database Ready"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#155E75" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="14">

            <Border
                Padding="18"
                BackgroundColor="#FFFFFF"
                Stroke="#A5F3FC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24">

                <VerticalStackLayout Spacing="14">
                    <Label
                        Text="Create Person"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#0C4A6E" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border
                            Stroke="#BAE6FD"
                            StrokeThickness="1"
                            BackgroundColor="#F0FDFF"
                            Padding="12,2"
                            StrokeShape="RoundRectangle 16">
                            <Entry
                                x:Name="newPerson"
                                Placeholder="Type full name"
                                PlaceholderColor="#0891B2"
                                FontSize="16"
                                TextColor="#083344"
                                ClearButtonVisibility="WhileEditing" />
                        </Border>

                        <Button
                            Grid.Column="1"
                            Text="Add"
                            Clicked="OnNewButtonClicked"
                            WidthRequest="88"
                            HeightRequest="48"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#06B6D4"
                            CornerRadius="14" />
                    </Grid>

                    <Label
                        x:Name="statusMessage"
                        TextColor="#0E7490"
                        FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Border
                Grid.Row="1"
                Padding="14"
                BackgroundColor="#E0F2FE"
                Stroke="#BAE6FD"
                StrokeShape="RoundRectangle 20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label
                            Text="Saved Records"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="#0C4A6E" />
                        <Label
                            Text="Tap refresh to sync with your local table"
                            FontSize="12"
                            TextColor="#0369A1" />
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="Refresh"
                        Clicked="OnGetButtonClicked"
                        HeightRequest="42"
                        Padding="18,0"
                        BackgroundColor="#0EA5E9"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14" />
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Padding="12"
                BackgroundColor="#FFFFFF"
                Stroke="#BAE6FD"
                StrokeShape="RoundRectangle 24">
                <CollectionView
                    x:Name="peopleList"
                    SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="26" Spacing="8">
                            <Label
                                Text="No people yet"
                                HorizontalTextAlignment="Center"
                                TextColor="#155E75"
                                FontSize="16"
                                FontAttributes="Bold" />
                            <Label
                                Text="Add your first record above, then refresh."
                                HorizontalTextAlignment="Center"
                                TextColor="#0E7490"
                                FontSize="13" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6,6,6,8">
                                <Border
                                    Padding="14"
                                    BackgroundColor="#F0FDFF"
                                    Stroke="#67E8F9"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            BackgroundColor="#06B6D4"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14">
                                            <Label
                                                Text="🙂"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                FontSize="20" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label
                                                Text="{Binding Name}"
                                                TextColor="#083344"
                                                FontSize="17"
                                                FontAttributes="Bold" />
                                            <Label
                                                Text="{Binding Id, StringFormat='Record #{0}'}"
                                                TextColor="#0E7490"
                                                FontSize="12" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="2"
                                            Text="SQL"
                                            VerticalOptions="Center"
                                            FontSize="10"
                                            TextColor="#0891B2"
                                            FontAttributes="Bold" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
