<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Astronomy.Pages.MoonPhasePage"
             BackgroundColor="#020617"
             Title="Moon Phase">

    <Grid>
        <Image Source="starfield.png" Aspect="AspectFill" Opacity="0.35" />
        <BoxView Color="#020617" Opacity="0.45" />

        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="14">
                <Border StrokeThickness="0" BackgroundColor="#0EA5E9" StrokeShape="RoundRectangle 24" Padding="16">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label x:Name="lblDate" TextColor="#083344" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="lblMoonPhaseIcon" FontSize="82" HorizontalTextAlignment="Center" />
                        <Label x:Name="lblMoonPhaseText" TextColor="#082F49" FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Grid.Row="0" Grid.Column="0" Stroke="#155E75" BackgroundColor="#111827" StrokeShape="RoundRectangle 16" Padding="12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label x:Name="lblPhaseIcon1" FontSize="44" HorizontalTextAlignment="Center" />
                            <Label x:Name="lblPhaseText1" TextColor="#A5F3FC" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Stroke="#155E75" BackgroundColor="#111827" StrokeShape="RoundRectangle 16" Padding="12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label x:Name="lblPhaseIcon2" FontSize="44" HorizontalTextAlignment="Center" />
                            <Label x:Name="lblPhaseText2" TextColor="#A5F3FC" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Stroke="#155E75" BackgroundColor="#111827" StrokeShape="RoundRectangle 16" Padding="12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label x:Name="lblPhaseIcon3" FontSize="44" HorizontalTextAlignment="Center" />
                            <Label x:Name="lblPhaseText3" TextColor="#A5F3FC" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Stroke="#155E75" BackgroundColor="#111827" StrokeShape="RoundRectangle 16" Padding="12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label x:Name="lblPhaseIcon4" FontSize="44" HorizontalTextAlignment="Center" />
                            <Label x:Name="lblPhaseText4" TextColor="#A5F3FC" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
