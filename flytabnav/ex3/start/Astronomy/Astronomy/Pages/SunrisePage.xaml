<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Astronomy.Pages.SunrisePage"
             Title="Sunrise"
             BackgroundColor="#0B1120">

    <Grid RowDefinitions="Auto,Auto,*" Padding="18" RowSpacing="14">
        <Border StrokeThickness="0" BackgroundColor="#0891B2" StrokeShape="RoundRectangle 22" Padding="16">
            <VerticalStackLayout Spacing="6">
                <Label Text="Daily Sun Timeline" TextColor="#042F2E" FontAttributes="Bold" FontSize="24" />
                <Label x:Name="lblDate" TextColor="#164E63" FontSize="14" />
            </VerticalStackLayout>
        </Border>

        <ActivityIndicator Grid.Row="1" x:Name="activityWaiting" IsRunning="False" Color="#F59E0B" />

        <VerticalStackLayout Grid.Row="2" Spacing="12">
            <Border Stroke="#334155" BackgroundColor="#0F172A" StrokeShape="RoundRectangle 18" Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="🌅" FontSize="30" />
                    <Label Text="Sunrise" TextColor="#67E8F9" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label x:Name="lblSunrise" TextColor="White" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Stroke="#334155" BackgroundColor="#0F172A" StrokeShape="RoundRectangle 18" Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="☀️" FontSize="30" />
                    <Label Text="Daylight" TextColor="#67E8F9" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label x:Name="lblDaylight" TextColor="White" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Border Stroke="#334155" BackgroundColor="#0F172A" StrokeShape="RoundRectangle 18" Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="🌇" FontSize="30" />
                    <Label Text="Sunset" TextColor="#67E8F9" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label x:Name="lblSunset" TextColor="White" VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
