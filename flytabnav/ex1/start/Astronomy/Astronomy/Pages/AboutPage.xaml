<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Astronomy.Pages.AboutPage"
             Title="About"
             BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Border StrokeThickness="0" BackgroundColor="#2563EB" StrokeShape="RoundRectangle 20" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Contoso Astronomy" TextColor="White" FontSize="26" FontAttributes="Bold" />
                    <Label Text="Space tools in one compact app" TextColor="#DBEAFE" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#334155" BackgroundColor="#111827" StrokeShape="RoundRectangle 16" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Version 1.0.0" TextColor="White" FontAttributes="Bold" />
                    <Label Text="Sunrise and sunset data source:" TextColor="#93C5FD" />
                    <Label Text="https://sunrise-sunset.org/api" TextColor="#E2E8F0" />
                    <Label Text="Moon and sun icons are from Font Awesome." TextColor="#E2E8F0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
