<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cvt="clr-namespace:WeatherClient.Converters"
             x:Class="WeatherClient.MainPage"
             BackgroundColor="#070D1F">

    <ContentPage.Resources>
        <cvt:WeatherConditionToImageConverter x:Key="WeatherConditionToImageConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0">
            <BoxView Color="#091832" />

            <ScrollView>
                <VerticalStackLayout Padding="20,26,20,100" Spacing="16">

                    <Border StrokeThickness="0"
                            BackgroundColor="#132952"
                            StrokeShape="RoundRectangle 28">
                        <Grid Padding="20" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0"
                                   Text="Good day, explorer"
                                   FontSize="14"
                                   TextColor="#8FB5F0" />

                            <Label Grid.Row="1"
                                   Text="Weather + Activity Hub"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="#F4F8FF" />

                            <Border Grid.RowSpan="2"
                                    Grid.Column="1"
                                    BackgroundColor="#1C4277"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="10"
                                    VerticalOptions="Center">
                                <Image HeightRequest="28"
                                       WidthRequest="28"
                                       Source="sunny.png" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border StrokeThickness="0"
                            BackgroundColor="#102441"
                            StrokeShape="RoundRectangle 24">
                        <VerticalStackLayout Padding="16" Spacing="12">
                            <Label Text="Check your weather"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#F4F8FF" />

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="8">
                                <Entry x:Name="txtPostalCode"
                                       Placeholder="Postal code"
                                       Keyboard="Text"
                                       BackgroundColor="#0A1A31"
                                       TextColor="#F2F6FD"
                                       PlaceholderColor="#7E9EC8"
                                       HeightRequest="50" />

                                <Button x:Name="btnRefresh"
                                        Grid.Column="1"
                                        Text="Go"
                                        Clicked="btnRefresh_Clicked"
                                        HeightRequest="50"
                                        Padding="20,0"
                                        BackgroundColor="#5AB2FF"
                                        TextColor="#051B34"
                                        FontAttributes="Bold"
                                        CornerRadius="14" />

                                <ActivityIndicator x:Name="actIsBusy"
                                                   Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   HorizontalOptions="Center"
                                                   Color="#5AB2FF" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border StrokeThickness="0"
                            BackgroundColor="#102746"
                            StrokeShape="RoundRectangle 24">
                        <VerticalStackLayout Padding="16" Spacing="14">
                            <HorizontalStackLayout Spacing="10">
                                <Image HeightRequest="24"
                                       WidthRequest="24"
                                       Source="{Binding Condition, Converter={StaticResource WeatherConditionToImageConverter}}" />
                                <Label Text="Today’s Weather"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#F4F8FF" />
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">
                                <Border StrokeThickness="0" BackgroundColor="#17365D" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout Padding="12" Spacing="2">
                                        <Label Text="Temp" TextColor="#9EB8DC" FontSize="12" />
                                        <Label Text="{Binding Temperature}" FontSize="22" FontAttributes="Bold" TextColor="#F4F8FF" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#17365D" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout Padding="12" Spacing="2">
                                        <Label Text="Humidity" TextColor="#9EB8DC" FontSize="12" />
                                        <Label Text="{Binding Humidity}" FontSize="22" FontAttributes="Bold" TextColor="#F4F8FF" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="#17365D" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout Padding="12" Spacing="2">
                                        <Label Text="Rain" TextColor="#9EB8DC" FontSize="12" />
                                        <Label Text="{Binding Precipitation}" FontSize="22" FontAttributes="Bold" TextColor="#F4F8FF" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" StrokeThickness="0" BackgroundColor="#17365D" StrokeShape="RoundRectangle 16">
                                    <VerticalStackLayout Padding="12" Spacing="2">
                                        <Label Text="Wind" TextColor="#9EB8DC" FontSize="12" />
                                        <Label Text="{Binding Wind}" FontSize="22" FontAttributes="Bold" TextColor="#F4F8FF" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border StrokeThickness="0"
                            BackgroundColor="#12305A"
                            StrokeShape="RoundRectangle 20">
                        <HorizontalStackLayout Padding="14" Spacing="12">
                            <Label Text="💡" FontSize="22" VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Tip of the day"
                                       FontAttributes="Bold"
                                       TextColor="#F4F8FF" />
                                <Label Text="Great weather for outdoor plans. Keep hydration with you."
                                       FontSize="13"
                                       TextColor="#C6D8F5" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Activities"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#F4F8FF" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border StrokeThickness="0" BackgroundColor="#112A4C" StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Padding="14" Spacing="8">
                                    <Label Text="Morning Walk" FontAttributes="Bold" TextColor="#F4F8FF" />
                                    <Label Text="Best at 7:00 - 9:00 AM" FontSize="12" TextColor="#9EB8DC" />
                                    <ActivityIndicator IsRunning="True" Color="#62C6FF" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#112A4C" StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Padding="14" Spacing="8">
                                    <Label Text="Evening Run" FontAttributes="Bold" TextColor="#F4F8FF" />
                                    <Label Text="Best at 5:30 - 7:00 PM" FontSize="12" TextColor="#9EB8DC" />
                                    <ActivityIndicator IsRunning="True" Color="#62C6FF" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Border Grid.Row="1"
                Margin="20,0,20,20"
                Padding="8"
                StrokeThickness="0"
                BackgroundColor="#17375F"
                StrokeShape="RoundRectangle 22">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Weather"
                        BackgroundColor="#5AB2FF"
                        TextColor="#06203F"
                        FontAttributes="Bold"
                        CornerRadius="16" />
                <Button Grid.Column="1"
                        Text="Activities"
                        BackgroundColor="#0E2543"
                        TextColor="#C7D9F5"
                        FontAttributes="Bold"
                        CornerRadius="16" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
