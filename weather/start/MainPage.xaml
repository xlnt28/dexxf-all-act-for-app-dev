<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cvt="clr-namespace:WeatherClient.Converters"
             x:Class="WeatherClient.MainPage"
             BackgroundColor="#06101F">

    <ContentPage.Resources>
        <cvt:WeatherConditionToImageConverter x:Key="WeatherConditionToImageConverter" />
    </ContentPage.Resources>

    <Grid>
        <BoxView Color="#0B1D36" />

        <ScrollView>
            <VerticalStackLayout Padding="22,28" Spacing="18">

                <Border StrokeThickness="0"
                        BackgroundColor="#102A4C"
                        StrokeShape="RoundRectangle 26">
                    <Grid Padding="22" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="Weather Forecast"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="#F3F7FF" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="Check the latest weather conditions for your area."
                               FontSize="14"
                               TextColor="#BBD2F5" />

                        <Border Grid.RowSpan="2"
                                Grid.Column="1"
                                VerticalOptions="Center"
                                BackgroundColor="#183A69"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="10">
                            <Image HeightRequest="26"
                                   WidthRequest="26"
                                   Source="sunny.png" />
                        </Border>
                    </Grid>
                </Border>

                <Border StrokeThickness="0"
                        BackgroundColor="#122D50"
                        StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout Padding="18" Spacing="14">

                        <Label Text="Search Location"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#F2F6FD" />

                        <Label Text="Enter a postal code to load the forecast."
                               FontSize="13"
                               TextColor="#9EB8DC" />

                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="10"
                              RowSpacing="10">

                            <Entry x:Name="txtPostalCode"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Placeholder="Postal code"
                                   Keyboard="Text"
                                   BackgroundColor="#0C203A"
                                   TextColor="#F2F6FD"
                                   PlaceholderColor="#7E9EC8"
                                   HeightRequest="52" />

                            <Button x:Name="btnRefresh"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="Refresh"
                                    Clicked="btnRefresh_Clicked"
                                    HeightRequest="52"
                                    Padding="22,0"
                                    BackgroundColor="#48A7FF"
                                    TextColor="#041428"
                                    FontAttributes="Bold"
                                    CornerRadius="16" />

                            <ActivityIndicator x:Name="actIsBusy"
                                               Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               HorizontalOptions="Center"
                                               Color="#48A7FF" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="0"
                        BackgroundColor="#102845"
                        StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout Padding="18" Spacing="16">

                        <HorizontalStackLayout Spacing="12">
                            <Border StrokeThickness="0"
                                    BackgroundColor="#17375E"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12">
                                <Image HeightRequest="36"
                                       WidthRequest="36"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Source="{Binding Condition, Converter={StaticResource WeatherConditionToImageConverter}}" />
                            </Border>

                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Today’s Forecast"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#F2F6FD" />
                                <Label Text="Live weather details"
                                       FontSize="13"
                                       TextColor="#9EB8DC" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="12">

                            <Border Grid.Row="0" Grid.Column="0"
                                    StrokeThickness="0"
                                    BackgroundColor="#163659"
                                    StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Padding="14" Spacing="4">
                                    <Label Text="Temperature"
                                           FontSize="13"
                                           TextColor="#9EB8DC" />
                                    <Label Text="{Binding Temperature}"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="#F2F6FD" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1"
                                    StrokeThickness="0"
                                    BackgroundColor="#163659"
                                    StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Padding="14" Spacing="4">
                                    <Label Text="Humidity"
                                           FontSize="13"
                                           TextColor="#9EB8DC" />
                                    <Label Text="{Binding Humidity}"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="#F2F6FD" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0"
                                    StrokeThickness="0"
                                    BackgroundColor="#163659"
                                    StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Padding="14" Spacing="4">
                                    <Label Text="Precipitation"
                                           FontSize="13"
                                           TextColor="#9EB8DC" />
                                    <Label Text="{Binding Precipitation}"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="#F2F6FD" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1"
                                    StrokeThickness="0"
                                    BackgroundColor="#163659"
                                    StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Padding="14" Spacing="4">
                                    <Label Text="Wind"
                                           FontSize="13"
                                           TextColor="#9EB8DC" />
                                    <Label Text="{Binding Wind}"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="#F2F6FD" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
