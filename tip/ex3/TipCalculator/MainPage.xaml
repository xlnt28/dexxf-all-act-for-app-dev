<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TipCalculator"
    x:Class="TipCalculator.MainPage"
    BackgroundColor="#0A1222">

    <ScrollView>
        <VerticalStackLayout Padding="20,28" Spacing="16">

            <Border StrokeThickness="0" BackgroundColor="#162A4B" StrokeShape="RoundRectangle 26">
                <VerticalStackLayout Padding="18" Spacing="6">
                    <Label Text="Smart Tip Calculator"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#F3F8FF" />
                    <Label Text="Quick split and round options for faster checkout."
                           FontSize="13"
                           TextColor="#BED4F5" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="0" BackgroundColor="#10213C" StrokeShape="RoundRectangle 22">
                <Grid Padding="16"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      RowSpacing="12"
                      ColumnSpacing="12">

                    <Label Text="Bill"
                           Grid.Row="0"
                           TextColor="#BED4F5"
                           VerticalOptions="Center" />
                    <Entry x:Name="billInput"
                           Grid.Row="0"
                           Grid.Column="1"
                           Placeholder="Enter amount"
                           Keyboard="Numeric"
                           BackgroundColor="#0B1930"
                           TextColor="#F3F8FF"
                           PlaceholderColor="#7E9EC8" />

                    <Label Text="Tip"
                           Grid.Row="1"
                           TextColor="#BED4F5" />
                    <Label x:Name="tipOutput"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="0.00"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#F3F8FF" />

                    <Label Text="Total"
                           Grid.Row="2"
                           TextColor="#BED4F5" />
                    <Label x:Name="totalOutput"
                           Grid.Row="2"
                           Grid.Column="1"
                           Text="0.00"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#65C4FF" />

                    <Grid Grid.Row="3"
                          Grid.ColumnSpan="2"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Text="Tip Percentage"
                               TextColor="#BED4F5"
                               VerticalOptions="Center" />
                        <Label x:Name="tipPercent"
                               Text="15%"
                               TextColor="#F3F8FF"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </Grid>
            </Border>

            <Border StrokeThickness="0" BackgroundColor="#0F1E36" StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Slider x:Name="tipPercentSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="15"
                            MinimumTrackColor="#65C4FF"
                            MaximumTrackColor="#28466E"
                            ThumbColor="#9DD9FF" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="15%"
                                Clicked="OnNormalTip"
                                BackgroundColor="#284E84"
                                TextColor="#EAF4FF"
                                CornerRadius="14" />

                        <Button Grid.Column="1"
                                Text="20%"
                                Clicked="OnGenerousTip"
                                BackgroundColor="#3D64A0"
                                TextColor="#EAF4FF"
                                CornerRadius="14" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button x:Name="roundDown"
                                Grid.Column="0"
                                Text="Round Down"
                                BackgroundColor="#0A1A31"
                                BorderColor="#2C4E7A"
                                BorderWidth="1"
                                TextColor="#BED4F5"
                                CornerRadius="14" />

                        <Button x:Name="roundUp"
                                Grid.Column="1"
                                Text="Round Up"
                                BackgroundColor="#65C4FF"
                                TextColor="#07213F"
                                FontAttributes="Bold"
                                CornerRadius="14" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
